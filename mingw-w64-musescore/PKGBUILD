options=(!lto)
source=(
  "${_realname}::git+https://github.com/musescore/MuseScore.git#tag=v${pkgver}"
  "0001-CMake-Enable-C-20-for-MinGW-to-support-latest-cppwin.patch"
  "0002-Fix-thread-native-handle-cast-for-MinGW.patch"
  "0003-global-use-WinAPI-loader-on-MinGW.patch"
