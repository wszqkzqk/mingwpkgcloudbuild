_realname=musescore
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.7.1
pkgrel=1
pkgdesc="Create, play and print beautiful sheet music (mingw-w64)"
arch=(any)
mingw_arch=('ucrt64' 'mingw64' 'clang64' 'clangarm64')
url="https://musescore.org/"
license=(GPL-3.0-only)
depends=(
  ${MINGW_PACKAGE_PREFIX}-flac
  ${MINGW_PACKAGE_PREFIX}-dlfcn
  ${MINGW_PACKAGE_PREFIX}-harfbuzz
  ${MINGW_PACKAGE_PREFIX}-hicolor-icon-theme
  ${MINGW_PACKAGE_PREFIX}-freetype
  ${MINGW_PACKAGE_PREFIX}-libopusenc
  ${MINGW_PACKAGE_PREFIX}-libsndfile
  ${MINGW_PACKAGE_PREFIX}-opus
  ${MINGW_PACKAGE_PREFIX}-qt6-5compat
  ${MINGW_PACKAGE_PREFIX}-qt6-base
  ${MINGW_PACKAGE_PREFIX}-qt6-declarative
  ${MINGW_PACKAGE_PREFIX}-qt6-networkauth
  ${MINGW_PACKAGE_PREFIX}-qt6-scxml
  ${MINGW_PACKAGE_PREFIX}-qt6-svg
  ${MINGW_PACKAGE_PREFIX}-tinyxml2
  ${MINGW_PACKAGE_PREFIX}-zlib
  ${MINGW_PACKAGE_PREFIX}-zstd
)
