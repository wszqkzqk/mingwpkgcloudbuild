From 9bfc52e078f7194a4f00b88838d94ace35b4dcfa Mon Sep 17 00:00:00 2001
From: Zhou Qiankang <wszqkzqk@qq.com>
Date: Sat, 28 Mar 2026 19:22:59 +0800
Subject: [PATCH 3/6] global: use WinAPI loader on MinGW

---
 src/framework/global/dlib.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/framework/global/dlib.h b/src/framework/global/dlib.h
index 859a493a8f..501b3d10e2 100644
--- a/src/framework/global/dlib.h
+++ b/src/framework/global/dlib.h
@@ -23,7 +23,7 @@
 #ifndef MUSE_GLOBAL_DLIB_H
 #define MUSE_GLOBAL_DLIB_H
 
-#if defined(Q_OS_WIN) && !defined(__MINGW64__)
+#if defined(Q_OS_WIN)
 #include <windows.h>
 #else
 #include <dlfcn.h>
@@ -36,7 +36,7 @@
 namespace muse {
 inline void* loadLib(const io::path_t& path)
 {
-#if defined(Q_OS_WIN) && !defined(__MINGW64__)
+#if defined(Q_OS_WIN)
     return LoadLibrary(io::toNativeSeparators(path).toStdWString().data());
 #else
     return dlopen(io::toNativeSeparators(path).toStdString().data(), RTLD_LAZY);
@@ -45,7 +45,7 @@ inline void* loadLib(const io::path_t& path)
 
 inline void* getLibFunc(void* libHandle, const char* funcName)
 {
-#if defined(Q_OS_WIN) && !defined(__MINGW64__)
+#if defined(Q_OS_WIN)
     return GetProcAddress((HINSTANCE)libHandle, funcName);
 #else
     return dlsym(libHandle, funcName);
@@ -54,7 +54,7 @@ inline void* getLibFunc(void* libHandle, const char* funcName)
 
 inline void closeLib(void* libHandle)
 {
-#if defined(Q_OS_WIN) && !defined(__MINGW64__)
+#if defined(Q_OS_WIN)
     UNUSED(libHandle);
     return;
 #else
